{
  "name": "@loginwa/mcp",
  "version": "0.1.0",
  "description": "Unofficial LoginWA MCP server: device status, OTP, send message, and broadcast campaigns for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "loginwa-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loginwa",
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "otp",
    "messaging",
    "broadcast",
    "ai-agent"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "LoginWA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satuapps/loginwa.git",
    "directory": "server-code/laravel-app/sdk/mcp"
  },
  "homepage": "https://loginwa.com",
  "bugs": {
    "url": "https://github.com/satuapps/loginwa/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
